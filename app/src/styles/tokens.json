      "background": "{primitive.color.neutral-950}",
      "surface": "{primitive.color.neutral-900}",
      "surface-raised": "{primitive.color.neutral-800}",
      "foreground": "{primitive.color.neutral-100}",
      "muted-foreground": "{primitive.color.neutral-400}",
      "border": "{primitive.color.neutral-700}",
