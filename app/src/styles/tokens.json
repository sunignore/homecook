      "green-fg": "{primitive.color.green-600}",
      "green-border": "{primitive.color.green-500}",
      "amber-bg": "{primitive.color.amber-100}",
      "amber-fg": "{primitive.color.amber-600}",
      "amber-border": "{primitive.color.amber-500}",
