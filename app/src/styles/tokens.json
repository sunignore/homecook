      "green-fg": "{primitive.color.green-100}",
      "green-border": "{primitive.color.green-500}",
      "amber-bg": "{primitive.color.amber-900}",
      "amber-fg": "{primitive.color.amber-100}",
      "amber-border": "{primitive.color.amber-500}",
      "red-bg": "{primitive.color.red-900}",
      "red-fg": "{primitive.color.red-100}",
      "red-border": "{primitive.color.red-500}"
    }
