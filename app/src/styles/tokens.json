      "neutral-800": "hsl(22 14% 18%)",
      "neutral-900": "hsl(22 16% 12%)",
      "neutral-950": "hsl(22 18% 8%)",

      "accent-400": "hsl(18 88% 62%)",
      "accent-500": "hsl(16 84% 52%)",
      "accent-600": "hsl(15 78% 44%)",
      "accent-700": "hsl(14 74% 35%)",

      "green-100": "hsl(145 55% 92%)",
      "green-500": "hsl(145 55% 34%)",
      "green-600": "hsl(147 58% 27%)",
      "green-900": "hsl(148 45% 14%)",

      "amber-100": "hsl(42 92% 90%)",
      "amber-500": "hsl(35 88% 38%)",
      "amber-600": "hsl(33 90% 31%)",
      "amber-900": "hsl(35 60% 14%)",

      "red-100": "hsl(6 85% 94%)",
      "red-500": "hsl(2 72% 44%)",
      "red-600": "hsl(2 76% 36%)",
      "red-900": "hsl(4 55% 15%)",

      "white": "hsl(0 0% 100%)",
      "black": "hsl(0 0% 0%)"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "full": "9999px"
    },
    "font": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Pretendard Variable', Pretendard, 'Noto Sans KR', 'Malgun Gothic', 'Segoe UI', sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
    },
    "size": {
      "caption": "14px",
      "body": "16px",
      "lead": "20px",
      "h2": "24px",
      "h1": "28px",
