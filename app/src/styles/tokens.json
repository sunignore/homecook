  "component": {
    "button-primary-bg": "{semantic.accent}",
    "button-primary-fg": "{semantic.accent-foreground}",
    "button-quiet-fg": "{semantic.muted-foreground}",
    "button-danger-bg": "{semantic.red-bg}",
    "button-danger-fg": "{semantic.red-fg}",
    "button-danger-border": "{semantic.red-border}",
    "card-bg": "{semantic.surface}",
    "card-border": "{semantic.border}",
    "tab-bar-bg": "{semantic.surface}",
    "tab-active-fg": "{semantic.accent}",
    "tab-inactive-fg": "{semantic.muted-foreground}",
    "input-bg": "{semantic.surface}",
    "input-border": "{semantic.border}",
    "step-text": "{semantic.foreground}",
    "step-done-text": "{semantic.muted-foreground}",
    "timer-ring": "{semantic.accent}",
    "timer-readout": "{semantic.foreground}",
    "chip-bg": "{semantic.surface-raised}",
    "chip-fg": "{semantic.muted-foreground}"
