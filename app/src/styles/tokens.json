      "cook-step": "28px",
      "cook-heading": "32px",
      "cook-timer": "48px"
    },
    "duration": {
      "fast": "150ms",
      "route": "250ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "target": {
      "min": "44px",
      "cook": "64px"
    }
  },
