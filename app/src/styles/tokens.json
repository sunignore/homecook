    "color": {
      "neutral-50": "hsl(30 33% 98%)",
      "neutral-100": "hsl(30 20% 95%)",
      "neutral-200": "hsl(28 15% 88%)",
      "neutral-300": "hsl(28 12% 78%)",
      "neutral-400": "hsl(26 10% 62%)",
